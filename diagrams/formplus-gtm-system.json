{
  "title": "Formplus: outbound GTM system, end to end",
  "subtitle": "v1 design from context/docs/gtm-system.md, not built yet. Row 1 reads left to right, row 2 right to left, row 3 left to right.",
  "rows": [
    {
      "title": "Find and qualify accounts",
      "direction": "ltr",
      "columns": [
        "1A",
        "1B",
        "1C",
        "1D",
        "1E",
        "1F",
        "1G"
      ]
    },
    {
      "title": "Route, find the people and get approval",
